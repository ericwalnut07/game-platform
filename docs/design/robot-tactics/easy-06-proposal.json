    "enemyAI": {
      "base": "M01 proposed deterministic normal-attack behavior with control-zone objective awareness",
      "tacticalGoals": [
        "If an enemy can legally enter E5–G7 at the end of its turn, prioritize contesting if otherwise the player would score at round end.",
        "Attack a player robot in the control zone when in legal range, especially if lethal; no attacks through blocking walls.",
        "At least one surviving enemy aims to end its round inside the zone if reasonably reachable; others may support with ranged attacks or flank.",
        "If no immediate legal attack/zone entry is possible, path toward contesting area while respecting unit movement and obstacles.",
        "Enemy presence in the zone only prevents an allied score; enemies do not themselves earn control points.",
        "Enemies never wait deliberately as a tutorial handicap and do not receive hidden buffs."
      ],
      "roleSpecific": {
        "raider-0": "melee rush into the nearer zone edge; target exposed allied unit",
        "guard-0": "durable center occupier that blocks scoring by standing in zone",
        "gunner-0": "maintain a useful ranged firing lane against zone occupants; enter zone if unguarded and legal",
        "raider-wave-3": "pressure E5/F5 from western side to interrupt possible consecutive scoring",
        "guard-wave-5": "durable recontest from east, forcing an active clearance before last four rounds"
      },
      "deterministicTieBreak": "reference common AI and stable enemy-id/target-id/cell ordering; no ad hoc RNG",
      "requiresGlobalCore": [
        "initiative",
        "legal movement by type",
        "attack range and LOS",
        "killed actor removed from occupied-zone set before end-of-round test"
      ]
    },
    "balanceSanity": {
      "alliedReferenceLevels": [
        4,
        5
