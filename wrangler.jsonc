{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "game-platform",
  "compatibility_date": "2026-09-20",
  "main": "./src/server/worker.ts",
  "assets": {
    "not_found_handling": "single-page-application"
  },
  "triggers": {
    "crons": [
      "17 3 * * *"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "RoomObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "RoomObject"
      ]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "game-platform-db",
      "database_id": "661625a0-8377-464e-84f2-f7c6e2bf425b"
    }
  ]
}
