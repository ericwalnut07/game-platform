{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "game-platform",
  "compatibility_date": "2026-09-20",
  "main": "./src/server/worker.ts",
  "assets": {
    "not_found_handling": "single-page-application"
  },
  "triggers": {
    "crons": ["17 3 * * *"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "RoomObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RoomObject"]
    }
  ]
}
